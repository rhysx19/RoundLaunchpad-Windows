<Application x:Class="RoundLaunchpad.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ShutdownMode="OnExplicitShutdown">
    <Application.Resources>
        <SolidColorBrush x:Key="BgBrush" Color="#F218181C"/>
        <SolidColorBrush x:Key="FgBrush" Color="#F0FFFFFF"/>
        <SolidColorBrush x:Key="MutedBrush" Color="#A0FFFFFF"/>
        <SolidColorBrush x:Key="AccentBrush" Color="#FF7AA2FF"/>
        <Style TargetType="Window">
            <Setter Property="Background" Value="#FFF5F5F7"/>
            <Setter Property="Foreground" Value="#FF1C1C1E"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style TargetType="ToggleButton">
            <Setter Property="Padding" Value="8,4"/>
        </Style>
    </Application.Resources>
</Application>
